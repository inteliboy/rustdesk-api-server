# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

RUSTDESK_API_HOST=0.0.0.0
RUSTDESK_API_PORT=21114

DATABASE_URL=sqlite:///./data/rustdesk.db

# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

ALLOW_REGISTRATION=false
# With registration on, a new account cannot sign in until an administrator
# activates it on the Users page. Set to false only if anyone who can reach this
# server should get a working account at once.
REGISTRATION_REQUIRES_APPROVAL=true

DEVICE_ONLINE_TIMEOUT=120

LOG_LEVEL=INFO

API_DOCS_ENABLED=true

CORS_ORIGINS=

# Trusted proxy hosts, comma separated. Leave empty to disable X-Forwarded-* trust.
TRUSTED_PROXIES=

# Public URL this server is reachable at (used for links, cookies, etc.)
EXTERNAL_URL=http://127.0.0.1:21114

# Commit this build was made from, shown on the Dashboard. Leave empty: the Docker
# image sets it, and from a git checkout it is read from git.
GIT_COMMIT=

RUSTDESK_ID_SERVER=
RUSTDESK_RELAY_SERVER=
RUSTDESK_KEY=

# Session/token lifetime in seconds
SESSION_LIFETIME_SECONDS=604800

# Rate limiting for auth endpoints
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Per client IP per minute, for the unauthenticated /api/audit/* endpoints
# RustDesk clients post connection / file-transfer events to.
CLIENT_AUDIT_RATE_LIMIT_PER_MINUTE=300

# Log retention. Logs older than this many days are deleted by a background task
# (once at startup, then every LOG_RETENTION_INTERVAL_HOURS). 0 keeps that kind
# forever. The audit log is the WebUI's activity feed; the connection setting
# covers the connection, file-transfer and alarm logs RustDesk clients
# report. NOTE: on upgrade, anything older than these limits is deleted on the
# first start. Run `rustdesk-api purge-logs --dry-run` to preview.
AUDIT_LOG_RETENTION_DAYS=365
CONNECTION_LOG_RETENTION_DAYS=180
LOG_RETENTION_INTERVAL_HOURS=24

# Dashboard "Server" section: how often (seconds, 5-300) the API server samples its
# CPU/memory, and how many minutes (5-360) of readings are kept in memory.
SERVER_METRICS_INTERVAL_SECONDS=10
SERVER_METRICS_HISTORY_MINUTES=60

# WHOIS-style details (network / organisation / country) for public IPs in the
# WebUI, looked up over RDAP (rdap.org and the regional registries). Only public
# IPs are sent; private/LAN addresses never leave this server. Set to false to
# make no outbound lookups at all. Results are cached for 24 hours.
IP_LOOKUP_ENABLED=true
IP_LOOKUP_TIMEOUT_SECONDS=4
IP_LOOKUP_MAX_PER_MINUTE=30

# RustDesk client address book: false = the newer per-item protocol (personal
# plus shared address books); true = force every client onto the legacy
# whole-list "Legacy address book". Both use the same personal book.
ADDRESS_BOOK_LEGACY_MODE=false

# Encrypts the secrets this server must be able to read back - today, the
# connection passwords the RustDesk client saves in a SHARED address book.
# Empty (the default) means those passwords are accepted but not stored, so
# "save password" in a shared book does not persist. Generate a key with:
#   rustdesk-api generate-key
# Keep it separate from SECRET_KEY and back it up separately from the database:
# without it the stored passwords cannot be recovered. To rotate, put the new
# key first and keep the old one after it (comma separated), run
# `rustdesk-api rotate-data-key`, then drop the old key.
DATA_ENCRYPTION_KEY=

# Two-factor authentication also needs DATA_ENCRYPTION_KEY (the authenticator
# secret is stored encrypted with it). If the key is lost, accounts with 2FA
# cannot sign in until an administrator runs `rustdesk-api disable-2fa`.

# RustDesk clients built with preset-* options (address book, group, user,
# strategy ...) send them in their system-info upload, which has no credentials.
# Leave this false unless you use such clients: true lets anyone who can reach
# this server place a NEW device in a named user's address book/group/strategy.
# `rustdesk --assign` (which is authenticated) works either way.
ALLOW_SYSINFO_PRESETS=false

# A known device id that uploads its system info with a DIFFERENT uuid is not
# the same install, and the upload carries no credentials, so anyone who knows
# (or guesses) the 9-digit id could otherwise take the device over.
#   approve (default) - park the new uuid; the device's owner or an
#                       administrator accepts or rejects it on the device page
#   deny              - ignore such uploads
#   allow             - adopt the new uuid (old behaviour, not recommended)
# An upload made while signed in as the device's owner or an administrator is
# always trusted.
DEVICE_UUID_REBIND=approve

# How long an administrator-issued password-reset link works (minutes, 5-10080).
PASSWORD_RESET_LIFETIME_MINUTES=60

# Lock an account for LOGIN_LOCKOUT_MINUTES after this many wrong passwords in
# a row (the right password is refused while locked). 0 turns it off. An
# administrator can unlock on the Users page or with `rustdesk-api unlock-user`.
# Note that anyone can lock a known username this way; the per-IP rate limit
# (AUTH_RATE_LIMIT_ATTEMPTS) keeps that slow.
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15

# Comma-separated networks (CIDR, or single addresses) allowed to use the WebUI
# and the management API (/api/v1, /docs). Empty = everyone. RustDesk clients
# (/api/login, /api/heartbeat, ...), /health and /metrics are never restricted.
# Behind a reverse proxy TRUSTED_PROXIES must list the proxy, or every request
# appears to come from it. Example: 10.0.0.0/8,192.168.0.0/16
WEBUI_ALLOWED_NETWORKS=

# Bearer token for Prometheus to scrape GET /metrics (at least 16 characters;
# `rustdesk-api generate-key` makes a good one). Empty = /metrics is off.
METRICS_TOKEN=

# Single sign-on with OpenID Connect (Keycloak, Authentik, Google, Microsoft Entra, Okta, ...).
# Off unless both OIDC_ISSUER and OIDC_CLIENT_ID are set. Register this redirect URI with the
# provider: <EXTERNAL_URL>/api/oidc/callback (it must be https, except for localhost). Needs a real
# SECRET_KEY. See "Single sign-on" in the README.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE only).
OIDC_CLIENT_SECRET=
# The button label in the RustDesk client ("Continue with <Name>") and the WebUI.
OIDC_NAME=sso
OIDC_SCOPES=openid email profile
# A sign-in that matches no linked account may create a plain user. Needs the domain list below.
OIDC_AUTO_CREATE_USERS=false
# ... or may be linked to the local user with the same VERIFIED e-mail address. Anyone who controls
# that address at the provider then gets that account, so leave it off unless you trust the provider.
OIDC_LINK_BY_EMAIL=false
# Comma-separated; limits auto-creation and e-mail linking to these domains. Example: example.com
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_USERNAME_CLAIM=preferred_username
OIDC_TIMEOUT_SECONDS=10

# Set to true to require HTTPS-only cookies (enable behind TLS reverse proxy)
SECURE_COOKIES=false

# Optional: serve HTTPS directly from uvicorn using these files (e.g. a local
# self-signed cert for testing). Leave both empty to serve plain HTTP, which
# is the normal setup when a reverse proxy in front of this server terminates
# TLS instead (CLAUDE.md section 47). See docs/local-https-testing.md.
SSL_CERTFILE=
SSL_KEYFILE=
